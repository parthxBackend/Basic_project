# Copy this file to .env and fill in your values
# MongoDB Atlas connection string (replace with your cluster URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/group-study?retryWrites=true&w=majority

# Secret key for signing JWTs — use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Port the server listens on (Render sets this automatically)
PORT=5000
